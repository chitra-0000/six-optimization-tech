<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

    <xsl:output method="xml" indent="yes"/>
    <xsl:strip-space elements="*"/>

    <xsl:template match="/">
        <INSTRUMENT_FILES>
            <xsl:apply-templates select="SANCTIONS/INSTRUMENTS/INSTRUMENT"/>
        </INSTRUMENT_FILES>
    </xsl:template>

    <xsl:template match="INSTRUMENT">
        <xsl:for-each select="TARGETS/TARGET">
            <INSTRUMENT_FILE>
            <RECORD_ORIGIN>
                <xsl:value-of select="../../RECORD_ORIGIN"/>
            </RECORD_ORIGIN>

            <LINK_ENTITY>
                <xsl:value-of select="../../LINK_ENTITY"/>
            </LINK_ENTITY>

            <LINK_CSID>
                <xsl:value-of select="../../CS_CODE"/>
            </LINK_CSID>

            <SANCTIONED_PARENT_ENTITY>
                <xsl:value-of select="../../SANCTIONED_PARENT_ENTITY"/>
            </SANCTIONED_PARENT_ENTITY>

            <NAME_DIRECT_ISSUER>
                <xsl:value-of select="../../NAME_DIRECT_ISSUER"/>
            </NAME_DIRECT_ISSUER>

            <CONFIDENCE_LEVEL>
                <xsl:value-of select="../../CONFIDENCE_LEVEL"/>
            </CONFIDENCE_LEVEL>

            <!-- ================= IDENTIFIERS ================= -->
            <CH_VALOR>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='CH']/VALUE"/>
            </CH_VALOR>

            <ISIN>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='ISIN']/VALUE"/>
            </ISIN>

            <SEDOL>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='SEDOL']/VALUE"/>
            </SEDOL>

            <CUSIP>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='CUSIP']/VALUE"/>
            </CUSIP>

            <CINS>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='CINS']/VALUE"/>
            </CINS>

            <AUSTRIAN>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='AUSTRIAN']/VALUE"/>
            </AUSTRIAN>

            <BELGIAN>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='BELGIAN']/VALUE"/>
            </BELGIAN>

            <CANADIAN>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='CANADIAN']/VALUE"/>
            </CANADIAN>

            <GERMAN>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='GERMAN']/VALUE"/>
            </GERMAN>

            <DENMARK>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='DENMARK']/VALUE"/>
            </DENMARK>

            <FRANCE_RGA>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='FRANCE_RGA']/VALUE"/>
            </FRANCE_RGA>

            <FRANCE_EUROCLEAR>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='FRANCE_EUROCLEAR']/VALUE"/>
            </FRANCE_EUROCLEAR>

            <ITALIAN>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='ITALIAN']/VALUE"/>
            </ITALIAN>

            <JAPANESE_CURRENT>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='JAPANESE_CURRENT']/VALUE"/>
            </JAPANESE_CURRENT>

            <JAPANESE_NEW>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='JAPANESE_NEW']/VALUE"/>
            </JAPANESE_NEW>

            <LUXEMBOURG>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='LUXEMBOURG']/VALUE"/>
            </LUXEMBOURG>

            <NETHERLAND>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='NETHERLAND']/VALUE"/>
            </NETHERLAND>

            <NORWEGIAN>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='NORWEGIAN']/VALUE"/>
            </NORWEGIAN>

            <SWEDISH>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='SWEDISH']/VALUE"/>
            </SWEDISH>

            <PORTUGAL>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='PORTUGAL']/VALUE"/>
            </PORTUGAL>

            <SOUTH_KOREA>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='SOUTH_KOREA']/VALUE"/>
            </SOUTH_KOREA>

            <HONG_KONG>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='HONG_KONG']/VALUE"/>
            </HONG_KONG>

            <XS_INT_NUMBER>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='XS_INT_NUMBER']/VALUE"/>
            </XS_INT_NUMBER>

            <FIGI_GLOBAL_ID>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='FIGI_GLOBAL_ID']/VALUE"/>
            </FIGI_GLOBAL_ID>

            <FIGI_GLOBAL_SHARE_CLASS_ID>
                <xsl:value-of select="../../IDENTIFIERS/IDENTIFIER[@TYPE='FIGI_GLOBAL_SHARE_CLASS_LEVEL_ID']/VALUE"/>
            </FIGI_GLOBAL_SHARE_CLASS_ID>

            <!-- ================= INSTRUMENT DETAILS ================= -->
            <INSTR_NAME>
                <xsl:value-of select="../../INSTR_NAME"/>
            </INSTR_NAME>

            <FISN>
                <xsl:value-of select="../../FISN"/>
            </FISN>

            <INDICATIVE_ISSUE_DATE>
                <xsl:value-of select="../../INDICATIVE_ISSUE_DATE"/>
            </INDICATIVE_ISSUE_DATE>

            <ISSUE_DATE>
                <xsl:value-of select="../../ISSUE_DATE"/>
            </ISSUE_DATE>

            <SUBSTITUTE_ISSUE_DATE>
                <xsl:value-of select="../../SUBSTITUTE_ISSUE_DATE"/>
            </SUBSTITUTE_ISSUE_DATE>

            <CAPITAL_CHANGE_DATE>
                <xsl:value-of select="../../CAPITAL_CHANGE_DATE"/>
            </CAPITAL_CHANGE_DATE>

            <INSTRUMENT_TYPE>
                <xsl:value-of select="../../INSTRUMENT_TYPE"/>
            </INSTRUMENT_TYPE>

            <SANCTION_RELEVANT_ASSET_CLASS>
                <xsl:value-of select="../../RELEVANT_ASSET_CLASS"/>
            </SANCTION_RELEVANT_ASSET_CLASS>

            <MAIN_INSTRUMENT>
                <xsl:value-of select="../../MAIN_INSTRUMENT"/>
            </MAIN_INSTRUMENT>

            <EQUITY_TYPE_OF_ISSUANCE>
                <xsl:value-of select="../../EQUITY_TYPE_OF_ISSUANCE"/>
            </EQUITY_TYPE_OF_ISSUANCE>

            <DENOMINATION_CURRENCY>
                <xsl:value-of select="../../DENOMINATION_CURRENCY"/>
            </DENOMINATION_CURRENCY>

            <MATURITY_DATE>
                <xsl:value-of select="../../MATURITY_DATE"/>
            </MATURITY_DATE>

            <DEBT_LIFETIME_IN_DAYS>
                <xsl:value-of select="../../DEBT_LIFETIME_IN_DAYS"/>
            </DEBT_LIFETIME_IN_DAYS>

            <ACTIVE_FLAG>
                <xsl:value-of select="../../ACTIVE_FLAG"/>
            </ACTIVE_FLAG>

            <DATE_OPENED_IN_SIX>
                <xsl:value-of select="../../DATE_OPENED_IN_SIX"/>
            </DATE_OPENED_IN_SIX>

            <ACTUAL_CAPITAL>
                <xsl:value-of select="../../ACTUAL_CAPITAL"/>
            </ACTUAL_CAPITAL>

            <REFERENCE_CAPITAL>
                <xsl:value-of select="../../REFERENCE_CAPITAL"/>
            </REFERENCE_CAPITAL>

            <!-- ================= ROLES ================= -->
            <OBLIGOR_ROLE>
                <xsl:value-of select="../../ROLES/ROLE[@TYPE='Ultimate borrower / Obligor']/@TYPE"/>
            </OBLIGOR_ROLE>

            <!-- TODO: the next two select paths were cut off at the right edge of the screen after 'UNDERLYING_OBLIG...' - check in the IDE -->
            <UNDERLYING_OBLIGOR>
                <xsl:value-of select="../../ROLES/ROLE[@TYPE='Ultimate borrower / Obligor']/UNDERLYING_OBLIGOR"/>
            </UNDERLYING_OBLIGOR>

            <UNDERLYING_OBLIGOR_GK>
                <xsl:value-of select="../../ROLES/ROLE[@TYPE='Ultimate borrower / Obligor']/UNDERLYING_OBLIGOR_GK"/>
            </UNDERLYING_OBLIGOR_GK>

            <!-- ================= OLS AGGREGATION ================= -->
            <OLS_YES>
                <xsl:for-each select="REGIMES/REGIME[OLS='Yes']">
                    <xsl:value-of select="@NAME"/>
                    <xsl:if test="position()!=last()">
                        <xsl:text> </xsl:text>
                    </xsl:if>
                </xsl:for-each>
            </OLS_YES>

            <OLS_NO>
                <xsl:for-each select="REGIMES/REGIME[OLS='No']">
                    <xsl:value-of select="@NAME"/>
                    <xsl:if test="position()!=last()">
                        <xsl:text> </xsl:text>
                    </xsl:if>
                </xsl:for-each>
            </OLS_NO>

            <REGIMES>
                <xsl:for-each select="REGIMES/REGIME[normalize-space(OLS)='Yes']">
                    <xsl:value-of select="concat(@NAME, ' - ', LEGAL_BASIS)"/>
                    <xsl:if test="position()!=last()">
                        <xsl:text> </xsl:text>
                    </xsl:if>
                </xsl:for-each>
            </REGIMES>

            <TARGETS>
                <xsl:variable name="targetName" select="@NAME"/>
                <xsl:for-each select="REGIMES/REGIME">
                    <SIX_TARGET>
                        <TARGET><xsl:value-of select="$targetName"/></TARGET>
                        <REGIME><xsl:value-of select="@NAME"/></REGIME>
                        <LEGAL_BASIS>
                            <xsl:choose>
                                <xsl:when test="normalize-space(LEGAL_BASIS) = 'N.E.'"/>
                                <xsl:otherwise>
                                    <xsl:value-of select="LEGAL_BASIS"/>
                                </xsl:otherwise>
                            </xsl:choose>
                        </LEGAL_BASIS>
                        <SANCTIONED><xsl:value-of select="../../SANCTIONED"/></SANCTIONED>
                        <SANCTIONS_RATIONALE><xsl:value-of select="../../SANCTIONS_RATIONALE"/></SANCTIONS_RATIONALE>
                        <STATUS><xsl:value-of select="../../STATUS"/></STATUS>
                        <SANCTION_FLAG_CHANGED><xsl:value-of select="../../SANCTION_FLAG_CHANGED"/></SANCTION_FLAG_CHANGED>
                        <REASON_FOR_CHANGE><xsl:value-of select="../../REASON_FOR_CHANGE"/></REASON_FOR_CHANGE>
                    </SIX_TARGET>
                </xsl:for-each>
            </TARGETS>

            </INSTRUMENT_FILE>
        </xsl:for-each>
    </xsl:template>

</xsl:stylesheet>
